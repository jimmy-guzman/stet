{
  "name": "stet-monorepo",
  "private": true,
  "license": "MIT",
  "repository": "github:jimmy-guzman/stet",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/tui build",
    "build:dist": "bun run --cwd packages/tui build:dist",
    "check": "bun run fmt:check && bun run lint && bun run test && bun run typecheck && bun run knip",
    "docs:build": "bun run --cwd docs build",
    "docs:check": "bun run gen:keys --check && bun run --cwd docs typecheck",
    "docs:dev": "bun run --cwd docs dev",
    "fmt": "bun --bun x oxfmt",
    "fmt:check": "bun --bun x oxfmt --check",
    "gen:keys": "bun run --cwd packages/tui gen:keys",
    "knip": "knip",
    "lint": "bun --bun x oxlint",
    "lint:fix": "bun --bun x oxlint --fix",
    "prepare": "effect-language-service patch",
    "screenshots": "bun run --cwd packages/tui screenshots",
    "stet": "bun run --cwd packages/tui stet",
    "test": "bun run --cwd packages/tui test",
    "typecheck": "bun run --filter '*' typecheck",
    "fix": "bun --bun x ultracite fix"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "ultracite": "8.2.0"
  }
}
