{
  "name": "stet",
  "version": "0.10.1",
  "private": true,
  "description": "Read-only companion TUI for inspecting an agent's changes",
  "license": "MIT",
  "repository": "github:jimmy-guzman/stet",
  "bin": {
    "stet": "./src/main.tsx"
  },
  "type": "module",
  "scripts": {
    "build": "bun run script/build.ts --single --skip-install",
    "build:dist": "bun script/build.ts",
    "gen:keys": "bun run script/gen-docs-keys.ts",
    "screenshots": "bun run script/screenshots.ts",
    "stet": "bun run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@pierre/diffs": "1.4.3",
    "diff": "9.0.0",
    "effect": "4.0.0-rc.116",
    "jsonc-parser": "3.3.1",
    "shiki": "4.4.3",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  }
}
